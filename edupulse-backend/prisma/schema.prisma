generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum FeedbackSubmissionStatus {
  DRAFT
  SUBMITTED
  ANALYZED
}

enum GrievanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ESCALATED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
  CRITICAL
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum AuditAction {
  LOGIN
  FEEDBACK_SUBMITTED
  FEEDBACK_FORM_PUBLISHED
  FEEDBACK_FORM_TURNED_OFF
  GRIEVANCE_SUBMITTED
  GRIEVANCE_VIEWED
  ANALYSIS_RUN
  REPORT_VIEWED
  REPORT_DOWNLOADED
  ACTION_ITEM_CREATED
  ACTION_STATUS_UPDATED
}

model College {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  domain      String?
  logoUrl     String?
  isActive    Boolean              @default(true)
  departments Department[]
  users       User[]
  terms       AcademicTerm[]
  categories  FeedbackCategory[]
  questions   FeedbackQuestion[]
  submissions FeedbackSubmission[]
  responses   FeedbackResponse[]
  grievances  Grievance[]
  reports     AnalysisReport[]
  themes      ThemeInsight[]
  actions     ActionItem[]
  auditLogs   AuditLog[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive])
}

model Department {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  name      String
  code      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, code])
  @@unique([collegeId, name])
  @@index([collegeId])
}

model User {
  id              String               @id @default(cuid())
  collegeId       String
  college         College              @relation(fields: [collegeId], references: [id])
  name            String
  email           String               @unique
  passwordHash    String
  role            UserRole
  departmentId    String?
  department      Department?          @relation(fields: [departmentId], references: [id])
  semesterNumber  Int?
  feedback        FeedbackSubmission[]
  grievances      Grievance[]          @relation("GrievanceReporter")
  assignedActions ActionItem[]         @relation("ActionOwner")
  auditLogs       AuditLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([collegeId])
  @@index([role])
  @@index([departmentId])
  @@index([collegeId, role])
}

model AcademicTerm {
  id          String               @id @default(cuid())
  collegeId   String
  college     College              @relation(fields: [collegeId], references: [id])
  name        String
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean              @default(false)
  submissions FeedbackSubmission[]
  reports     AnalysisReport[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([collegeId, name])
  @@index([collegeId])
  @@index([collegeId, isActive])
}

model FeedbackCategory {
  id          String             @id @default(cuid())
  collegeId   String
  college     College            @relation(fields: [collegeId], references: [id])
  name        String
  description String?
  questions   FeedbackQuestion[]
  responses   FeedbackResponse[]
  themes      ThemeInsight[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([collegeId, name])
  @@index([collegeId])
}

model FeedbackQuestion {
  id         String             @id @default(cuid())
  collegeId  String
  college    College            @relation(fields: [collegeId], references: [id])
  categoryId String
  category   FeedbackCategory   @relation(fields: [categoryId], references: [id])
  text       String
  isActive   Boolean            @default(true)
  responses  FeedbackResponse[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([collegeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([collegeId, isActive])
}

model FeedbackSubmission {
  id        String                   @id @default(cuid())
  collegeId String
  college   College                  @relation(fields: [collegeId], references: [id])
  studentId String
  student   User                     @relation(fields: [studentId], references: [id])
  termId    String
  term      AcademicTerm             @relation(fields: [termId], references: [id])
  status    FeedbackSubmissionStatus @default(SUBMITTED)
  responses FeedbackResponse[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([studentId, termId])
  @@index([collegeId])
  @@index([studentId])
  @@index([termId])
  @@index([status])
  @@index([collegeId, termId])
}

model FeedbackResponse {
  id           String             @id @default(cuid())
  collegeId    String
  college      College            @relation(fields: [collegeId], references: [id])
  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id])
  categoryId   String
  category     FeedbackCategory   @relation(fields: [categoryId], references: [id])
  questionId   String
  question     FeedbackQuestion   @relation(fields: [questionId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime           @default(now())

  @@index([collegeId])
  @@index([submissionId])
  @@index([categoryId])
  @@index([questionId])
  @@index([rating])
  @@index([collegeId, categoryId])
  @@index([collegeId, rating])
}

model Grievance {
  id          String            @id @default(cuid())
  collegeId   String
  college     College           @relation(fields: [collegeId], references: [id])
  reporterId  String?
  reporter    User?             @relation("GrievanceReporter", fields: [reporterId], references: [id])
  category    String
  title       String
  description String
  severity    GrievanceSeverity
  status      GrievanceStatus   @default(OPEN)
  isAnonymous Boolean           @default(false)
  safetyFlag  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([collegeId])
  @@index([reporterId])
  @@index([severity])
  @@index([status])
  @@index([safetyFlag])
  @@index([collegeId, status])
  @@index([collegeId, severity])
}

model AnalysisReport {
  id             String         @id @default(cuid())
  collegeId      String
  college        College        @relation(fields: [collegeId], references: [id])
  termId         String
  term           AcademicTerm   @relation(fields: [termId], references: [id])
  title          String
  summary        String
  confidence     Float
  inputCount     Int
  lowSampleFlag  Boolean        @default(false)
  duplicateCount Int            @default(0)
  generatedBy    String?
  rawJson        Json?
  themes         ThemeInsight[]
  actions        ActionItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([collegeId])
  @@index([termId])
  @@index([confidence])
  @@index([createdAt])
  @@index([collegeId, termId])
}

model ThemeInsight {
  id           String            @id @default(cuid())
  collegeId    String
  college      College           @relation(fields: [collegeId], references: [id])
  reportId     String
  report       AnalysisReport    @relation(fields: [reportId], references: [id])
  categoryId   String?
  category     FeedbackCategory? @relation(fields: [categoryId], references: [id])
  title        String
  summary      String
  sentiment    SentimentLabel
  priority     PriorityLevel
  mentionCount Int
  evidence     Json?
  createdAt    DateTime          @default(now())

  @@index([collegeId])
  @@index([reportId])
  @@index([categoryId])
  @@index([sentiment])
  @@index([priority])
  @@index([collegeId, priority])
}

model ActionItem {
  id        String         @id @default(cuid())
  collegeId String
  college   College        @relation(fields: [collegeId], references: [id])
  reportId  String
  report    AnalysisReport @relation(fields: [reportId], references: [id])
  title     String
  ownerId   String?
  owner     User?          @relation("ActionOwner", fields: [ownerId], references: [id])
  priority  PriorityLevel
  status    ActionStatus   @default(TODO)
  timeline  String
  kpi       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([collegeId])
  @@index([reportId])
  @@index([ownerId])
  @@index([priority])
  @@index([status])
  @@index([collegeId, status])
}

model AuditLog {
  id        String      @id @default(cuid())
  collegeId String
  college   College     @relation(fields: [collegeId], references: [id])
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  action    AuditAction
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([collegeId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([collegeId, action])
}
